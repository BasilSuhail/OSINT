# Copy to .env and fill. Never commit .env.

# Postgres
#
# For local docker (default): leave POSTGRES_HOST=localhost and pick any strong
# POSTGRES_PASSWORD. The docker-compose stack reads this password too.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=osint
POSTGRES_USER=osint
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# FRED API (free registration: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# NASA FIRMS MAP_KEY (free registration: https://firms.modaps.eosdis.nasa.gov/api/area/)
FIRMS_MAP_KEY=

# ACLED manual CSV import. Download CSVs from myACLED / Data Export / Aggregated data.
ACLED_CSV_DIR=./data/private/acled
ACLED_CSV_PATH=

# Optional ACLED API path. Disabled by default because most accounts get 403.
ACLED_API_ENABLED=false
ACLED_USERNAME=
ACLED_PASSWORD=

# EM-DAT CSV export/import path (local file, never commit raw licensed data)
EMDAT_CSV_PATH=

# Optional cyber IP geolocation for abuse.ch rows. Bounded per fetch.
CYBER_GEO_ENABLED=true
CYBER_GEO_MAX_LOOKUPS=25

# Pushover (optional, for alerting)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Local storage — all DB/redis/archive data lives here (one folder).
# Laptop: leave default. Pi/external HDD: set an absolute path, e.g. /mnt/raid/osint/data
OSINT_DATA_DIR=./data

# Retention windows (days). Default: keep ~a month of events.
RETENTION_GDELT_DAYS=30
RETENTION_NEWS_DAYS=30
RETENTION_HAZARD_DAYS=30

# Hard ceiling on database disk use (GB). When exceeded, the nightly
# housekeeping job deletes the oldest whole days of events (never newer than
# STORAGE_CAP_FLOOR_DAYS; fred/emdat exempt). Note: Postgres files plateau at
# their peak size — the cap stops growth, it does not shrink files.
# 40GB box: 26 leaves headroom for OS + Docker images + WAL/Redis/logs.
STORAGE_CAP_GB=30
STORAGE_CAP_FLOOR_DAYS=7

# Frontend → local read API (replaces Supabase REST/realtime).
# See docs/frontend/README.md for setup.
# Shared secret every API endpoint but /health requires (#824). Empty leaves
# the API open, which is fine on a laptop and is not fine anywhere reachable.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# Origins the dashboard may be served from, comma-separated. Add a device's own
# address here before opening the console on it, or the browser refuses every
# API call. For LAN, Pi or Tailscale that is the dashboard's own origin, e.g.
# http://pi.local:3000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:8000
# Must match API_AUTH_TOKEN when one is set: the dashboard is an API client.
NEXT_PUBLIC_API_TOKEN=

# Local memory discipline. Raise these on a bigger box; lower them on a Pi.
API_DEFAULT_LIMIT=2000
API_MAX_LIMIT=10000
NEXT_PUBLIC_EVENT_WINDOW_LIMIT=5000
NEXT_PUBLIC_EVENT_BUFFER_LIMIT=7500
NEXT_PUBLIC_HAZARD_EVENT_LIMIT=2500
NEXT_PUBLIC_CYBER_EVENT_LIMIT=1000
NEXT_PUBLIC_SCORE_ROW_LIMIT=2000
NEXT_PUBLIC_ANALYTICS_ROW_LIMIT=7500

# App
LOG_LEVEL=INFO
ENVIRONMENT=development

# Docker Compose project name is fixed in docker-compose.yml (name: osint).
# Do NOT set COMPOSE_PROJECT_NAME here — a stale override can pin compose to a
# corrupted old project and break `make up` with "No such container" errors.

# A second sea area for the vessel layer (#954): Norwegian coastal AIS. Open
# data, but behind a free account and an OAuth client, so it only contributes
# when both are set. Unset means the layer covers one sea area, which is a
# working configuration and not a fault.
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
# Aircraft watchlist (#954). Path to a JSON file of airframes to pull out of
# routine traffic — see app/presence/watchlist.example.json for the shape.
# Entries name an airframe by hex or registration, or watch a kind of flying:
# role, callsign_prefix or type. A rule needs no identifiers looked up first,
# so the example file works unedited. Unset means no watchlist, which is a
# working configuration.
# The file is operational data: keep it OUTSIDE the repository. It carries
# identifiers and the job an airframe does, never the name of a person.
PRESENCE_WATCHLIST_PATH=
