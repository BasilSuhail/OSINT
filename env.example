# Copy to .env and fill. Never commit .env.
#
# `make env` does the copying, and fills in the settings nobody should have to
# think of: the two credentials, and the addresses this machine answers to. It
# only ever fills a setting that is empty — anything you have written is left
# exactly as you wrote it.

# Postgres
#
# For local docker (default): leave POSTGRES_HOST=localhost. `make env`
# generates POSTGRES_PASSWORD if it is empty; the docker-compose stack reads it
# too. Put your own in instead and nothing will overwrite it.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=osint
POSTGRES_USER=osint
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# FRED API (free registration: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# NASA FIRMS MAP_KEY (free registration: https://firms.modaps.eosdis.nasa.gov/api/area/)
FIRMS_MAP_KEY=

# ACLED manual CSV import. Download CSVs from myACLED / Data Export / Aggregated data.
ACLED_CSV_DIR=./data/private/acled
ACLED_CSV_PATH=

# Optional ACLED API path. Disabled by default because most accounts get 403.
ACLED_API_ENABLED=false
ACLED_USERNAME=
ACLED_PASSWORD=

# EM-DAT CSV export/import path (local file, never commit raw licensed data)
EMDAT_CSV_PATH=

# Optional cyber IP geolocation for abuse.ch rows. Bounded per fetch.
CYBER_GEO_ENABLED=true
CYBER_GEO_MAX_LOOKUPS=25

# Pushover (optional, for alerting)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Who the backend containers run as. On Linux a bind mount keeps the host's
# ownership, so a container running as the image's own user cannot write to a
# data directory belonging to you — story exports and audit sheets fail with
# "Permission denied" (#984). `make env` fills these in from your account on
# Linux and leaves them empty everywhere else, because Docker Desktop fakes the
# ownership and does not need them.
DOCKER_UID=
DOCKER_GID=

# Local storage — all DB/redis/archive data lives here (one folder).
# Laptop: leave default. Pi/external HDD: set an absolute path, e.g. /mnt/raid/osint/data
OSINT_DATA_DIR=./data

# Retention windows (days). Default: keep ~a month of events.
# Set a window to 0 to switch the time rule off for the sources it covers, and
# STORAGE_CAP_GB below becomes the only thing that deletes an event: history is
# then kept until the disk budget says otherwise rather than until a date does.
# On a board with room for years of it, 0 is the setting that means "keep it".
RETENTION_GDELT_DAYS=30
RETENTION_NEWS_DAYS=30
RETENTION_HAZARD_DAYS=30

# Hard ceiling on database disk use (GB). When exceeded, the nightly
# housekeeping job deletes the oldest whole days of events (never newer than
# STORAGE_CAP_FLOOR_DAYS; fred/emdat exempt, and only those two). Note: Postgres files plateau at
# their peak size — the cap stops growth, it does not shrink files.
# 40GB box: 26 leaves headroom for OS + Docker images + WAL/Redis/logs.
STORAGE_CAP_GB=30
STORAGE_CAP_FLOOR_DAYS=7

# Frontend → local read API (replaces Supabase REST/realtime).
# See docs/frontend/README.md for setup.
# Shared secret every API endpoint but /health requires (#824). Empty leaves
# the API open, which is fine on a laptop and is not fine anywhere reachable,
# so `make env` generates one rather than leaving that to be noticed later.
API_AUTH_TOKEN=

# Origins the dashboard may be served from, comma-separated. A browser refuses
# every API call from an origin that is not on this list. `make env` adds each
# address this machine answers to; the ones written here are kept, never
# replaced, so nothing that already worked stops working.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Which name guests use for `make share`. Empty means the detected local
# address. Serve mode always uses Tailscale's MagicDNS name so its private
# HTTPS certificate matches.
#
# Set it to reach the console from somewhere the local network does not go — a
# VPN name, say. Give the name the other device would use, with no scheme and
# no port, then run `make env-refresh`. `make share` honours it too, and keeps
# the detected local address in the allow-list, so pinning never takes away the
# network that already worked.
OSINT_PUBLIC_HOST=

# Same-origin path proxied by Next locally and by the HTTPS frontend in a
# deployment. An absolute HTTP URL here becomes mixed content under HTTPS.
NEXT_PUBLIC_API_URL=/api
# Server-side upstream for `/api`. Leave blank for the local API. Set an HTTPS
# URL when Next is hosted separately from the API.
API_PROXY_TARGET=
# Must match API_AUTH_TOKEN: the dashboard is an API client. `make env` copies
# it across, and `make env-check` says so if the two ever drift apart.
NEXT_PUBLIC_API_TOKEN=

# The brain.
#
# Everything below this line is set for you. `make env` measures how much memory
# this machine has, and a machine of 9 GB or less gets a different set of values
# — one small model for every job instead of three, longer patience, and memory
# floors that match. It prints which set it chose and why.
#
# The values written here are the ones for a laptop. Change any of them and
# `make env` leaves your answer alone from then on.
#
# Whether the console answers questions. The search boxes are unaffected —
# they ask the full-text index and the gazetteer, and have never gone near a
# model. Off, the ask control is not drawn and the endpoint returns a sentence
# saying so. `make env` writes false on a machine of 9 GB or less, where an
# answer costs minutes and holds the box for all of them; write `true` here
# and `make env` leaves your answer alone from then on.
#
# Empty is on, which is why it ships empty rather than saying `true`. A key
# holding the value this file suggests is this file's answer and not yours, so
# `make env` may write over it — and a `true` typed back in on a small board
# has to survive every re-sync, or the box you asked for disappears again at
# the next `make env`.
#
# true/t/yes/y/on/1 and false/f/no/n/off/0 are the words understood, in any
# case. Anything else is not a shrug: the API refuses to start and says which
# key it could not read.
ASK_ENABLED=
# The console's copy, compiled into its bundle at build time. `make env`
# writes whatever ASK_ENABLED says across to it whenever this is empty, and
# `make env-check` says so if the two ever drift apart. Change the one above
# and leave this empty; a value typed here is treated as your answer and kept.
NEXT_PUBLIC_ASK_ENABLED=

# The four models. They are separate settings so a bench result can move one
# without the others; on a small machine all four become the same model, which
# is what lets Ollama load it once and reuse it rather than holding two.
BRAIN_MODEL=llama3.2:3b
QA_MODEL=qwen3.5:4b-q4_K_M
SEVERITY_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# How long Ollama holds a model after it answers. The Ask panel unloads at once
# by default, so on a small box every question reloads gigabytes from storage
# before generating a token — measured at 1 m 48 s an ask on a Raspberry Pi.
# "5m" makes the second question onward cost generation only.
BRAIN_KEEP_ALIVE=30m
QA_KEEP_ALIVE=0
# Refuse to load a model unless this much memory is free. Sized for the models
# above: too high for a small model and the console answers "brain busy" forever,
# too low and the load takes the machine down.
BRAIN_MIN_FREE_MB=3500
QA_MIN_FREE_MB=3800
# Seconds to wait for the model. Generous on a laptop, not enough on a small
# board — where the timeout reaches the console as "the brain is offline", which
# sends you looking for a broken install instead of a slow one.
BRAIN_TIMEOUT_S=120
# How long the written situation summary may go unwritten before it stops
# yielding to heavy jobs. It backs off while clustering or grading has the box,
# which is right on a laptop where those finish in seconds — and on a board
# where they run nose to tail it meant the summary never ran at all, five beats
# in a row, leaving the console empty. Four missed 15-minute beats.
BRAIN_NARRATE_STARVATION_MINUTES=60
# How long the console waits on a running answer, in milliseconds. The stream
# guard is the one that matters: it is reset by every chunk, so it measures
# silence rather than duration, and the longest silence in a healthy ask is the
# wait for the first token — about 100 s on a small board against 18 s on a
# laptop. Too low and the browser hangs up on a generation that is working, then
# reports it as the brain being offline.
NEXT_PUBLIC_STREAM_IDLE_TIMEOUT_MS=45000
NEXT_PUBLIC_ASK_TIMEOUT_MS=180000
# How many stories the Ask panel puts in front of the model. More is a better
# answer — more evidence, more sources it can cite. With a GPU that costs a
# second; without one it is nearly the whole cost of an answer, so a small
# machine sends fewer rather than running a weaker model.
QA_STORIES=6

# Local memory discipline. Raise these on a bigger box; lower them on a Pi.
API_DEFAULT_LIMIT=2000
API_MAX_LIMIT=10000
NEXT_PUBLIC_EVENT_WINDOW_LIMIT=5000
NEXT_PUBLIC_EVENT_BUFFER_LIMIT=7500
NEXT_PUBLIC_HAZARD_EVENT_LIMIT=2500
NEXT_PUBLIC_CYBER_EVENT_LIMIT=1000
NEXT_PUBLIC_SCORE_ROW_LIMIT=2000
NEXT_PUBLIC_ANALYTICS_ROW_LIMIT=7500

# App
LOG_LEVEL=INFO
ENVIRONMENT=development

# Docker Compose project name is fixed in docker-compose.yml (name: osint).
# Do NOT set COMPOSE_PROJECT_NAME here — a stale override can pin compose to a
# corrupted old project and break `make up` with "No such container" errors.

# A second sea area for the vessel layer (#954): Norwegian coastal AIS. Open
# data, but behind a free account and an OAuth client, so it only contributes
# when both are set. Unset means the layer covers one sea area, which is a
# working configuration and not a fault.
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
# Aircraft the live air layer follows (#954). Nothing needs setting: tankers
# and surveillance aircraft are followed out of the box. To follow something
# else, put a file at data/watchlist.json — see
# app/presence/watchlist.example.json for the shape. This key only exists to
# keep that file somewhere else, and the app reads it from inside its
# container, so it must name a path in there: /data/<file>.
PRESENCE_WATCHLIST_PATH=
