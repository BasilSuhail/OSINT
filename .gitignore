# Data / archives (never commit)
data/
/mnt/data/
# Whitelist the bundled Natural Earth polygons used for country enrichment.
!app/enrichment/data/
!app/enrichment/data/**
*.parquet
*.csv
*.zip
# Whitelist the published result panel, which travels with the supplementary
# material rather than being regenerated by a reader.
!results/data/
!results/data/**

# Logs
*.log
logs/

# Course material (NEVER commit to OSINT repo)
*.pptx
*.pdf

# Local dev artefacts
.tmp/
scratch/

# DB snapshots (scripts/snapshot.py output — data dumps, never commit)
backups/

# Celery beat local schedule state
celerybeat-schedule*

# Local strategy scratch (not tracked)
POSITIONING-SCRATCH.md

# Local .env backups may contain live credentials — never committable.
.env.backup-*

# The aircraft watchlist is operational data, never committed (#954). Only
# the .example file belongs in the repository.
watchlist.json
*.watchlist.json
data/watchlist.json

# The demo's frozen snapshot is the one data file that belongs in the
# repository: it is what the published page draws, it is already public by
# definition, and a page with no data is a page that looks broken. `data/`
# above ignores every directory of that name, wherever it sits, so it needs
# naming back.
!demo/data/
!demo/data/snapshot.json

# The main written report is drafted outside this repository and never lands
# in it: it carries a name that does not belong in a public history.
/report/
*.docx
